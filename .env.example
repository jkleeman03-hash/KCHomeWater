# Quote form email delivery (https://resend.com). Set these in Vercel > Project > Settings > Environment Variables.
RESEND_API_KEY=
QUOTE_TO_EMAIL=contact@kchomewater.com
# Optional. Must be on a domain verified in Resend; defaults to Resend's test sender.
QUOTE_FROM_EMAIL="KC Home Water <quotes@kchomewater.com>"

# GoHighLevel CRM. Settings > Private Integrations > create one with the "Edit Contacts" (contacts.write) scope.
GHL_API_KEY=
# Settings > Business Profile > Location ID (also in the sub-account URL: /location/<id>/).
GHL_LOCATION_ID=
